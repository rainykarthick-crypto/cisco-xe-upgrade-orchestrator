# Normalise line endings: LF in the repository.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-only helpers keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Never convert binaries or firmware images.
*.bin   binary
*.pkg   binary
*.exe   binary
*.zip   binary
*.png   binary
